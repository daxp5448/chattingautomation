# --- Backend ---------------------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/kelviontech

# Used by docker-compose.yml to set the postgres container's superuser password
# (and must match the password embedded in DATABASE_URL above). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Fernet key used to encrypt WhatsApp access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

S3_ENDPOINT_URL=http://minio:9000
# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below. Local dev can still use
# minioadmin/minioadmin if you choose, but don't ship that as this file's default.
S3_ACCESS_KEY=replace-with-a-minio-access-key
S3_SECRET_KEY=replace-with-a-minio-secret-key
S3_BUCKET=kelviontech-media
S3_REGION=us-east-1

# Used by docker-compose.yml to set the minio container's root credentials
# (and must match S3_ACCESS_KEY / S3_SECRET_KEY above).
MINIO_ROOT_USER=replace-with-a-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-minio-secret-key

# --- WhatsApp Cloud API ------------------------------------------------------
# Set once you have a Meta App + WhatsApp Business Account. Per-restaurant
# phone_number_id / access_token / verify_token are stored on the Restaurant
# record via the admin dashboard, not here -- this app secret and webhook verify
# token are the single app-level values Meta uses for the one webhook URL.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_GRAPH_API_VERSION=v20.0

CORS_ORIGINS=["http://localhost:3000"]

# Base URL of the owner/admin frontend -- used to build the one-time account-setup
# link emailed to a new restaurant owner (see app/api/v1/routers/restaurants.py).
FRONTEND_URL=http://localhost:3000

# --- Email (optional) --------------------------------------------------------
# Generic SMTP -- works with Gmail (an App Password, not your normal password),
# SendGrid/SES/Mailgun's SMTP relay, or any other provider. Used to email a new
# owner their setup link and to notify them if their restaurant is
# suspended/cancelled/reactivated. Leave SMTP_HOST blank to skip email entirely --
# nothing breaks, the setup link still shows in the dashboard for you to send
# yourself, it just won't go out automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Your Platform Name

# --- Frontend ----------------------------------------------------------------
# Server-side only -- used by frontend/next.config.mjs's rewrite proxy so the
# browser only ever talks to the frontend's own origin (needed for the httpOnly
# auth cookies to work simply). See frontend/.env.local.example for the rest of
# the frontend's env vars.
BACKEND_INTERNAL_URL=http://localhost:8000
