# Used server-side only, by next.config.mjs's rewrite proxy -- the browser never sees
# this. All normal HTTP API calls from the browser go to this app's own /api/v1/* (same
# origin), which the proxy forwards here.
BACKEND_INTERNAL_URL=http://localhost:8000

# Used client-side (must stay NEXT_PUBLIC_*) only to open the WebSocket directly against
# the backend for live order updates -- WebSocket auth uses a short-lived ticket/device
# token in the URL, not the httpOnly session cookie, so this one connection bypasses the
# same-origin proxy on purpose (see lib/useLiveSocket.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
